<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.payroll_project.controller.ReportsController"
      spacing="20">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="4">
            <Label text="Reports &amp; Analytics" styleClass="card-title" style="-fx-font-size: 28px;"/>
            <Label text="Generate payroll, statutory compliance, and attendance reports"
                   styleClass="card-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Tab Pane -->
    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE"
             style="-fx-tab-min-width: 180px;">

        <!-- ═══════════════════════════════════════════════════════
             TAB 1 – PAYROLL SUMMARY
             ═══════════════════════════════════════════════════════ -->
        <Tab text="📊  Payroll Summary">
            <VBox spacing="16" style="-fx-padding: 16px;">

                <!-- Filter row -->
                <VBox styleClass="card" spacing="12">
                    <Label text="Select Pay Period" style="-fx-font-weight: 600; -fx-font-size: 13px;"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <ComboBox fx:id="payrollPeriodCombo"
                                  promptText="Choose pay period…"
                                  style="-fx-pref-width: 320px;"/>
                        <Button text="⚙️  Generate Report" styleClass="button-primary"
                                onAction="#handleGeneratePayrollReport"
                                style="-fx-padding: 8px 18px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="📥  Export CSV" styleClass="button-secondary"
                                onAction="#handleExportPayrollReport"/>
                    </HBox>
                </VBox>

                <!-- Summary cards -->
                <GridPane hgap="16" vgap="0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>
                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="0">
                        <Label text="👥  Employees" styleClass="stat-label"/>
                        <Label fx:id="payrollEmpCount" text="—"
                               style="-fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="1">
                        <Label text="💰  Total Gross" styleClass="stat-label"/>
                        <Label fx:id="payrollTotalGross" text="—"
                               style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #1E3A8A;"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="2">
                        <Label text="➖  Total Deductions" styleClass="stat-label"/>
                        <Label fx:id="payrollTotalDeds" text="—"
                               style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #EF4444;"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="3">
                        <Label text="✅  Total Net Pay" styleClass="stat-label"/>
                        <Label fx:id="payrollTotalNet" text="—"
                               style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #10B981;"/>
                    </VBox>
                </GridPane>

                <!-- Table -->
                <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
                    <Label text="Employee Payroll Details" styleClass="card-title"
                           style="-fx-font-size: 15px;"/>
                    <TableView fx:id="payrollTable" VBox.vgrow="ALWAYS"
                               style="-fx-pref-height: 380px;">
                        <columns>
                            <TableColumn fx:id="pcCode"   text="Code"          prefWidth="75"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="pcName"   text="Employee"      prefWidth="160"/>
                            <TableColumn fx:id="pcDays"   text="Days"          prefWidth="50"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="pcRegHrs" text="Reg Hrs"       prefWidth="65"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="pcOtHrs"  text="OT Hrs"        prefWidth="60"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="pcBasic"  text="Basic Pay"     prefWidth="100"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="pcOtPay"  text="OT Pay"        prefWidth="90"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="pcNd"     text="Night Diff"    prefWidth="90"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="pcHol"    text="Holiday Pay"   prefWidth="90"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="pcGross"  text="Gross Pay"     prefWidth="105"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="pcSSS"    text="SSS"           prefWidth="85"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="pcPH"     text="PhilHealth"    prefWidth="85"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="pcPI"     text="Pag-IBIG"      prefWidth="80"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="pcTax"    text="Tax"           prefWidth="85"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="pcDeds"   text="Total Deds"    prefWidth="95"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="pcNet"    text="Net Pay"       prefWidth="105"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40px;">
                                <Label text="📊" style="-fx-font-size: 40px;"/>
                                <Label text="Select a pay period and click Generate Report"
                                       style="-fx-font-size: 14px; -fx-text-fill: #6B7280;"/>
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>

            </VBox>
        </Tab>

        <!-- ═══════════════════════════════════════════════════════
             TAB 2 – STATUTORY COMPLIANCE
             ═══════════════════════════════════════════════════════ -->
        <Tab text="💼  Statutory Compliance">
            <VBox spacing="16" style="-fx-padding: 16px;">

                <!-- Filter row -->
                <VBox styleClass="card" spacing="12">
                    <Label text="Select Pay Period" style="-fx-font-weight: 600; -fx-font-size: 13px;"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <ComboBox fx:id="statPeriodCombo"
                                  promptText="Choose pay period…"
                                  style="-fx-pref-width: 320px;"/>
                        <Button text="⚙️  Generate Report" styleClass="button-primary"
                                onAction="#handleGenerateStatutoryReport"
                                style="-fx-padding: 8px 18px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="📥  Export CSV" styleClass="button-secondary"
                                onAction="#handleExportStatutoryReport"/>
                    </HBox>
                </VBox>

                <!-- Summary cards -->
                <GridPane hgap="16" vgap="0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                    </columnConstraints>
                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="0">
                        <Label text="SSS (Employee)" styleClass="stat-label"/>
                        <Label fx:id="statTotalSSSEmp" text="—"
                               style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="1">
                        <Label text="SSS (Employer)" styleClass="stat-label"/>
                        <Label fx:id="statTotalSSSEr" text="—"
                               style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="2">
                        <Label text="PhilHealth (Emp)" styleClass="stat-label"/>
                        <Label fx:id="statTotalPHEmp" text="—"
                               style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="3">
                        <Label text="Pag-IBIG (Emp)" styleClass="stat-label"/>
                        <Label fx:id="statTotalPIEmp" text="—"
                               style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="4">
                        <Label text="Withholding Tax" styleClass="stat-label"/>
                        <Label fx:id="statTotalTax" text="—"
                               style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #EF4444;"/>
                    </VBox>
                </GridPane>

                <!-- Table -->
                <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
                    <Label text="Statutory Contributions per Employee" styleClass="card-title"
                           style="-fx-font-size: 15px;"/>
                    <TableView fx:id="statTable" VBox.vgrow="ALWAYS"
                               style="-fx-pref-height: 380px;">
                        <columns>
                            <TableColumn fx:id="scCode"   text="Code"         prefWidth="75"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="scName"   text="Employee"     prefWidth="160"/>
                            <TableColumn fx:id="scSalary" text="Monthly Sal." prefWidth="110"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="scSSSEmp" text="SSS (Emp)"    prefWidth="90"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="scSSSEr"  text="SSS (Er)"     prefWidth="90"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="scPHEmp"  text="PhilH (Emp)"  prefWidth="95"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="scPHEr"   text="PhilH (Er)"   prefWidth="90"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="scPIEmp"  text="PagIBIG (Emp)" prefWidth="100"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="scPIEr"   text="PagIBIG (Er)" prefWidth="100"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="scTax"    text="W/Tax"        prefWidth="90"
                                         style="-fx-alignment: CENTER_RIGHT;"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40px;">
                                <Label text="💼" style="-fx-font-size: 40px;"/>
                                <Label text="Select a pay period and click Generate Report"
                                       style="-fx-font-size: 14px; -fx-text-fill: #6B7280;"/>
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>

            </VBox>
        </Tab>

        <!-- ═══════════════════════════════════════════════════════
             TAB 3 – ATTENDANCE ANALYTICS
             ═══════════════════════════════════════════════════════ -->
        <Tab text="📈  Attendance Analytics">
            <VBox spacing="16" style="-fx-padding: 16px;">

                <!-- Filter row -->
                <VBox styleClass="card" spacing="12">
                    <Label text="Date Range" style="-fx-font-weight: 600; -fx-font-size: 13px;"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="From" style="-fx-font-weight: 600;"/>
                        <DatePicker fx:id="attFromDate" style="-fx-pref-width: 150px;"/>
                        <Label text="to" style="-fx-font-weight: 600;"/>
                        <DatePicker fx:id="attToDate" style="-fx-pref-width: 150px;"/>
                        <Button text="⚙️  Generate Report" styleClass="button-primary"
                                onAction="#handleGenerateAttendanceReport"
                                style="-fx-padding: 8px 18px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="📥  Export CSV" styleClass="button-secondary"
                                onAction="#handleExportAttendanceReport"/>
                    </HBox>
                </VBox>

                <!-- Summary cards -->
                <GridPane hgap="16" vgap="0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>
                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="0">
                        <Label text="✅  Days Present" styleClass="stat-label"/>
                        <Label fx:id="attPresentLbl" text="—"
                               style="-fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #10B981;"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="1">
                        <Label text="❌  Days Absent" styleClass="stat-label"/>
                        <Label fx:id="attAbsentLbl" text="—"
                               style="-fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #EF4444;"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="2">
                        <Label text="📊  Attendance Rate" styleClass="stat-label"/>
                        <Label fx:id="attRateLbl" text="—"
                               style="-fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #3B82F6;"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="3">
                        <Label text="⚠️  Anomalies" styleClass="stat-label"/>
                        <Label fx:id="attAnomalyLbl" text="—"
                               style="-fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #F59E0B;"/>
                    </VBox>
                </GridPane>

                <!-- Table -->
                <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
                    <Label text="Attendance Summary per Employee" styleClass="card-title"
                           style="-fx-font-size: 15px;"/>
                    <TableView fx:id="attTable" VBox.vgrow="ALWAYS"
                               style="-fx-pref-height: 380px;">
                        <columns>
                            <TableColumn fx:id="acCode"      text="Code"        prefWidth="75"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="acName"      text="Employee"    prefWidth="160"/>
                            <TableColumn fx:id="acDept"      text="Dept."       prefWidth="110"/>
                            <TableColumn fx:id="acWorked"    text="Days Worked" prefWidth="90"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="acAbsent"    text="Days Absent" prefWidth="90"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="acRegHrs"    text="Reg Hrs"     prefWidth="75"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="acOtHrs"     text="OT Hrs"      prefWidth="70"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="acNdHrs"     text="Night Diff"  prefWidth="80"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="acLate"      text="Late (min)"  prefWidth="80"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="acUnder"     text="Utime (min)" prefWidth="85"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="acAnomalies" text="Anomalies"   prefWidth="90"
                                         style="-fx-alignment: CENTER;"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40px;">
                                <Label text="📈" style="-fx-font-size: 40px;"/>
                                <Label text="Select a date range and click Generate Report"
                                       style="-fx-font-size: 14px; -fx-text-fill: #6B7280;"/>
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>

            </VBox>
        </Tab>

    </TabPane>

</VBox>
